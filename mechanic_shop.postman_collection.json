{
  "info": {
    "name": "Mechanic Shop API - Advanced",
    "description": "Every endpoint for the Coding Temple BE Module 1 Project. Start the app with `python app.py`, then run these against http://127.0.0.1:5001.\n\nOrder to follow: create a customer, then Login (which saves the token automatically), then create mechanics and inventory parts, then a service ticket, then assign/add.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers"
              ]
            },
            "description": "Create a customer. Rate limited to 5 per hour. Password is load_only so it never comes back in a response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Nguyen\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"815-555-0100\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login (get token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/login",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers",
                "login"
              ]
            },
            "description": "Returns an auth_token. The test script below saves it to the {{auth_token}} variable so the protected requests use it automatically. Rate limited to 10 per hour.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.auth_token) {",
                  "    pm.collectionVariables.set('auth_token', body.auth_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Customers (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/?page=1&per_page=10",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers",
                "?page=1&per_page=10"
              ]
            },
            "description": "Paginated. Change page and per_page in the query string."
          },
          "response": []
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/1",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers",
                "1"
              ]
            },
            "description": "One customer. 404 for a bad id."
          },
          "response": []
        },
        {
          "name": "My Tickets (token required)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/my-tickets",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers",
                "my-tickets"
              ]
            },
            "description": "Returns the logged-in customer's service tickets. Needs a Bearer token; the id comes from the token, not the URL.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Customer (token required)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers"
              ]
            },
            "description": "Updates the logged-in customer. No id in the URL, it comes from the token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice N.\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"815-555-0199\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Customer (token required)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5001/customers/",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5001",
              "path": [
                "customers"
              ]
            },
            "description": "Deletes the logged-in customer. Their service tickets cascade delete too.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
